{
  "name": "signal-lock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n game,vite \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
